<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.FXVelociraptor" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <item name="colorPrimary">#00FF88</item>
        <item name="colorPrimaryVariant">#00AA55</item>
        <item name="colorOnPrimary">#000000</item>
        <item name="colorSecondary">#FFAA00</item>
        <item name="colorOnSecondary">#000000</item>
        <item name="android:windowBackground">#0A0A0F</item>
        <item name="android:statusBarColor">#000000</item>
        <item name="android:navigationBarColor">#000000</item>
        <item name="actionBarStyle">@style/Theme.FXVelociraptor.ActionBar</item>
    </style>

    <style name="Theme.FXVelociraptor.ActionBar" parent="Widget.AppCompat.ActionBar">
        <item name="android:background">#0D0D14</item>
        <item name="titleTextStyle">@style/Theme.FXVelociraptor.ActionBarTitle</item>
    </style>

    <style name="Theme.FXVelociraptor.ActionBarTitle" parent="TextAppearance.AppCompat.Widget.ActionBar.Title">
        <item name="android:textColor">#00FF88</item>
        <item name="android:fontFamily">monospace</item>
    </style>

    <style name="Theme.FXVelociraptor.Splash" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:windowBackground">#0A0A0F</item>
        <item name="android:statusBarColor">#000000</item>
    </style>
</resources>
