<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0A0F">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="20dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🦖 FX VELOCIRAPTOR"
                android:textColor="#00FF88"
                android:textSize="20sp"
                android:textStyle="bold"
                android:fontFamily="monospace"/>

            <ImageButton
                android:id="@+id/btnSettings"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@android:drawable/ic_menu_preferences"
                android:background="@android:color/transparent"
                android:tint="#AAAAAA"/>

            <ImageButton
                android:id="@+id/btnHistory"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@android:drawable/ic_menu_recent_history"
                android:background="@android:color/transparent"
                android:tint="#AAAAAA"
                android:layout_marginStart="8dp"/>
        </LinearLayout>

        <!-- Status Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#111118"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tvBotStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="⚫ BOT ARRÊTÉ"
                    android:textColor="#888888"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:layout_marginBottom="16dp"/>

                <ProgressBar
                    android:id="@+id/progressConnecting"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:visibility="gone"
                    android:layout_marginBottom="16dp"/>

                <Button
                    android:id="@+id/btnToggleBot"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="▶ DÉMARRER LE BOT"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:backgroundTint="#00BB66"/>

                <!-- Danger Alert -->
                <TextView
                    android:id="@+id/tvDangerAlert"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="#FF4444"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:padding="8dp"
                    android:background="#1AFF0000"
                    android:layout_marginTop="12dp"
                    android:visibility="gone"/>

                <!-- Emergency Button -->
                <Button
                    android:id="@+id/btnEmergencyClose"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="🚨 FERMETURE D'URGENCE"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:backgroundTint="#CC0000"
                    android:enabled="false"
                    android:layout_marginTop="10dp"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Last Signal Card -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardLastSignal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#111118"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            android:layout_marginBottom="16dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🎯 DERNIER SIGNAL"
                    android:textColor="#FFAA00"
                    android:textSize="12sp"
                    android:letterSpacing="0.1"
                    android:layout_marginBottom="12dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:id="@+id/tvSignalSymbol"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="BUY EURUSD"
                        android:textColor="#00FF88"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:fontFamily="monospace"/>

                    <TextView
                        android:id="@+id/tvSignalConfidence"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="85%"
                        android:textColor="#FFAA00"
                        android:textSize="16sp"
                        android:textStyle="bold"/>
                </LinearLayout>

                <TextView
                    android:id="@+id/tvSignalPattern"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="DBR | ST1"
                    android:textColor="#888888"
                    android:textSize="13sp"
                    android:layout_marginBottom="12dp"/>

                <!-- Entry / SL / TP Grid -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="ENTRY" android:textColor="#555555" android:textSize="10sp"/>
                        <TextView android:id="@+id/tvSignalEntry" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:text="1.08500"
                            android:textColor="#FFFFFF" android:textSize="13sp" android:fontFamily="monospace"/>
                    </LinearLayout>

                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="STOP LOSS" android:textColor="#FF4444" android:textSize="10sp"/>
                        <TextView android:id="@+id/tvSignalSL" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:text="1.08200"
                            android:textColor="#FF6666" android:textSize="13sp" android:fontFamily="monospace"/>
                    </LinearLayout>

                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="TAKE PROFIT" android:textColor="#00AA55" android:textSize="10sp"/>
                        <TextView android:id="@+id/tvSignalTP" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:text="1.09100"
                            android:textColor="#00FF88" android:textSize="13sp" android:fontFamily="monospace"/>
                    </LinearLayout>

                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="R:R" android:textColor="#555555" android:textSize="10sp"/>
                        <TextView android:id="@+id/tvSignalRR" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:text="1:2.0"
                            android:textColor="#FFAA00" android:textSize="13sp" android:fontFamily="monospace"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Logs Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#0D0D14"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📋 JOURNAL DU BOT"
                    android:textColor="#555555"
                    android:textSize="11sp"
                    android:letterSpacing="0.1"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:id="@+id/tvLogs"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="En attente de démarrage..."
                    android:textColor="#447744"
                    android:textSize="11sp"
                    android:fontFamily="monospace"
                    android:lineSpacingExtra="4dp"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>
